{
  "manifest_version": 3,
  "name": "Job Tracker Quick Add",
  "description": "Capture the current page as a job application in your self-hosted Job Tracker.",
  "version": "1.0.0",
  "homepage_url": "https://github.com/allanweber/job-tracker",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Add to Job Tracker"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["config.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab"],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-tracker-quick-add@allanweber",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
